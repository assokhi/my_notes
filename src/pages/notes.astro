---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Notes" current="notes">
  <main class="mx-auto max-w-5xl px-6 py-16">
    <h1 class="text-4xl font-semibold tracking-tight text-slate-950">Notes</h1>
    <p class="mt-4 max-w-xl text-slate-600">Add your notes, articles, links, or updates here.</p>
    <section class="mt-10 border-t border-slate-200 pt-8">
      <h2 class="text-xl font-medium">Your first note</h2>
      <p class="mt-2 text-slate-600">Replace this placeholder with your own content.</p>
    </section>
  </main>
</Layout>