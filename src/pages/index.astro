---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" current="home">
  <main class="mx-auto max-w-5xl px-6 py-24">
    <p class="mb-4 text-sm font-medium uppercase tracking-widest text-slate-500">A simple place for ideas</p>
    <h1 class="max-w-2xl text-5xl font-semibold tracking-tight text-slate-950 sm:text-6xl">Welcome to my notes.</h1>
    <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">This is the home page. Add your introduction, projects, writing, or anything else here.</p>
    <a class="mt-8 inline-block rounded-md bg-slate-900 px-5 py-3 text-sm font-medium text-white hover:bg-slate-700" href={`${import.meta.env.BASE_URL}notes/`}>Read the notes</a>
  </main>
</Layout>