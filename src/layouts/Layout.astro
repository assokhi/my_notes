---
const { title, current } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <script src="https://cdn.tailwindcss.com"></script>
    <title>{title} | My Notes</title>
  </head>
  <body class="min-h-screen bg-white text-slate-900">
    <header class="border-b border-slate-200">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-5" aria-label="Main navigation">
        <a class="text-lg font-semibold tracking-tight" href={base}>My Notes</a>
        <div class="flex gap-5 text-sm text-slate-600">
          <a class={current === 'home' ? 'font-medium text-slate-900' : 'hover:text-slate-900'} href={base} aria-current={current === 'home' ? 'page' : undefined}>Home</a>
          <a class={current === 'notes' ? 'font-medium text-slate-900' : 'hover:text-slate-900'} href={`${base}notes/`} aria-current={current === 'notes' ? 'page' : undefined}>Notes</a>
          <a class={current === 'about' ? 'font-medium text-slate-900' : 'hover:text-slate-900'} href={`${base}about/`} aria-current={current === 'about' ? 'page' : undefined}>About</a>
        </div>
      </nav>
    </header>
    <slot />
  </body>
</html>